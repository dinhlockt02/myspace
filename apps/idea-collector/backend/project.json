{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "idea-collector-backend",
  "projectType": "application",
  "sourceRoot": "apps/idea-collector/backend",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go mod tidy",
        "cwd": "apps/idea-collector/backend"
      },
      "cache": true,
      "inputs": ["{projectRoot}/go.mod", "{projectRoot}/go.sum"],
      "outputs": ["{projectRoot}/go.sum"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "GOOS=linux GOARCH=amd64 go build -o main main.go",
        "cwd": "apps/idea-collector/backend"
      },
      "outputs": ["{projectRoot}/main"],
      "dependsOn": ["setup", "^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test ./...",
        "cwd": "apps/idea-collector/backend"
      },
      "dependsOn": ["setup"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go vet ./...",
        "cwd": "apps/idea-collector/backend"
      },
      "cache": true
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go run main.go",
        "cwd": "apps/idea-collector/backend"
      }
    }
  },
  "tags": ["app:idea-collector", "scope:backend", "type:app"]
}
