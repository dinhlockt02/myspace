{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "idea-collector-infra",
  "projectType": "library",
  "sourceRoot": "apps/idea-collector/deploy",
  "targets": {
    "plan": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cd apps/idea-collector/deploy/envs/dev && terraform init -backend=false && terraform plan"
        ]
      }
    },
    "plan-prod": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cd apps/idea-collector/deploy/envs/prod && terraform init -backend=false && terraform plan"
        ]
      }
    }
  },
  "tags": ["app:idea-collector", "scope:infra", "type:library"]
}
